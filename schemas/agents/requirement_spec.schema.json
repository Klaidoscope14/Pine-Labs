{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis://schemas/agents/requirement_spec.schema.json",
  "title": "requirement_spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "clarified_summary",
    "assumptions",
    "acceptance_criteria",
    "task_plan",
    "risk_flags"
  ],
  "properties": {
    "clarified_summary": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "verification_type",
          "must"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification_type": {
            "enum": [
              "unit_test",
              "integration_test",
              "replay",
              "contract",
              "manual"
            ]
          },
          "must": {
            "type": "boolean"
          }
        }
      }
    },
    "task_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "split_into": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
