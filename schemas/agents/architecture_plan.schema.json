{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aegis://schemas/agents/architecture_plan.schema.json",
  "title": "architecture_plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "impacted_modules",
    "design_summary",
    "interface_changes",
    "scope",
    "planned_tests",
    "diff_budget",
    "decision_log"
  ],
  "properties": {
    "impacted_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "design_summary": {
      "type": "string",
      "minLength": 1
    },
    "interface_changes": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planned",
        "adjacent",
        "protected_touched"
      ],
      "properties": {
        "planned": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "adjacent": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_touched": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "planned_tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diff_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "lines"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "decision_log": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "reason"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "alternatives": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
